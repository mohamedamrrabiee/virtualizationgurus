="geometry"/></mxCell><mxCell id="Sup99" value="" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;aspect=fixed;outlineConnect=0;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.vvd.virtual_machine;fillColor=#434445;" vertex="1" parent="1"><mxGeometry x="1320.0" y="1119.5" width="26.0" height="26.0" as="geometry"/></mxCell><mxCell id="Sup100" value="&lt;b&gt;Paths&lt;/b&gt; &amp;nbsp; Supervisor management: control plane eth0 on VLAN 3321 (vCenter, NSX, DNS, NTP) &amp;nbsp;|&amp;nbsp; Workload: CP VMs, VKS nodes and VMs on VPC subnets, out through the VPC gateway (SNAT) -&amp;gt; Transit Gateway -&amp;gt; Tier-0 on en02 -&amp;gt; lab router &amp;nbsp;|&amp;nbsp; In: users -&amp;gt; VIP (10.80.0.0/22, BGP) -&amp;gt; NSX load balancer -&amp;gt; nodes" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F1534;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="1620" height="45" as="geometry"/></mxCell><mxCell id="Sup101" value="&lt;b&gt;Legend&lt;/b&gt; &amp;nbsp; blue: Kubernetes / vSphere Namespace &amp;nbsp;|&amp;nbsp; amber: NSX routing objects &amp;nbsp;|&amp;nbsp; purple: w01 compute &amp;nbsp;|&amp;nbsp; double arrow: eBGP &amp;nbsp;|&amp;nbsp; icons: VMware Validated Design (VVD) stencils &amp;nbsp;|&amp;nbsp; centralized (Edge) connectivity" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F1534;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="1620" height="45" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>