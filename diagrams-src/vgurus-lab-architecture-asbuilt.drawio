arcSize=6;fontFamily=Arial;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="850" y="1010" width="380" height="75" as="geometry"/></mxCell><mxCell id="Edg81" value="" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;aspect=fixed;outlineConnect=0;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.vvd.server;fillColor=#434445;" vertex="1" parent="1"><mxGeometry x="860.0" y="1043.6" width="30.0" height="7.8" as="geometry"/></mxCell><mxCell id="Edg82" value="&lt;b&gt;Geneve overlay&lt;/b&gt; (UDP 6081)&lt;br&gt;host TEP 3328 &amp;lt;-&amp;gt; Edge TEP 3329, routed by the lab router&lt;br&gt;vmkping -d -s 8972 OK (TTL 63 = one routed hop)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4E0;strokeColor=#9AA0AE;fontColor=#1F1534;fontSize=10;align=left;verticalAlign=middle;spacing=6;arcSize=6;fontFamily=Arial;spacingLeft=40;" vertex="1" parent="1"><mxGeometry x="1245" y="1005" width="395" height="85" as="geometry"/></mxCell><mxCell id="Edg83" value="" style="sketch=0;pointerEvents=1;shadow=0;dashed=0;html=1;strokeColor=none;aspect=fixed;outlineConnect=0;labelPosition=center;verticalLabelPosition=bottom;verticalAlign=top;align=center;shape=mxgraph.vvd.vxlan;fillColor=#434445;" vertex="1" parent="1"><mxGeometry x="1255.0" y="1032.5" width="30.0" height="30.0" as="geometry"/></mxCell><mxCell id="Edg84" value="&lt;b&gt;Traffic paths&lt;/b&gt; &amp;nbsp; North-south: VM (172.20.1.x) -&amp;gt; VPC gateway (SNAT 10.80.0.0) -&amp;gt; Geneve -&amp;gt; Transit Gateway SR + Tier-0 SR on en02 -&amp;gt; uplink 3330/3331 -&amp;gt; lab router &amp;nbsp;|&amp;nbsp; East-west inside a VPC: host-to-host Geneve on VLAN 3328, never leaves the hosts &amp;nbsp;|&amp;nbsp; Private (172.20.x, private TGW) prefixes are never advertised" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=10;fontColor=#1F1534;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="40" y="1130" width="1620" height=